<Window x:Class="NetSpeed.GameBoost.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetSpeed GameBoost" Height="900" Width="1500"
        MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="#070B16" Foreground="#EAF7FF">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#B8CBE0"/>
            <Setter Property="Background" Value="#101A2B"/>
            <Setter Property="BorderBrush" Value="#20364D"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#101A2B"/>
            <Setter Property="BorderBrush" Value="#20364D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="7"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0B1322" CornerRadius="18" Padding="16" Margin="0,0,12,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="NETSPEED" FontSize="21" FontWeight="Bold" Foreground="#27D7F2"/>
                    <TextBlock Text="GAMEBOOST  /  PC" FontSize="11" Foreground="#8CA4BD" Margin="0,2,0,24"/>
                    <Button Style="{StaticResource NavButton}" Content="◈  控制中心"/>
                    <Button Style="{StaticResource NavButton}" Content="⌁  游戏加速"/>
                    <Button Style="{StaticResource NavButton}" Content="◎  节点网络"/>
                    <Button Style="{StaticResource NavButton}" Content="⇄  DNS 诊断"/>
                    <Button Style="{StaticResource NavButton}" Content="⬡  安全防护"/>
                    <Button Style="{StaticResource NavButton}" Content="⚙  设置"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                    <TextBlock Text="SYSTEM STATUS" Foreground="#8CA4BD" FontSize="10"/>
                    <TextBlock Text="本机监测模式" Foreground="#27D7F2" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="当前未启用流量接管" Foreground="#8CA4BD" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2.1*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="8,2,8,12">
                <StackPanel>
                    <TextBlock Text="游戏网络指挥中心" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="REAL-TIME NETWORK INTELLIGENCE" FontSize="10" Foreground="#8CA4BD" Margin="0,4,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#14283A" CornerRadius="18" Padding="14,8">
                    <TextBlock Text="●  本机监测运行中" Foreground="#65E6C2" FontSize="12"/>
                </Border>
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="7,0,7,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="GAME PROFILES" Foreground="#8CA4BD" FontSize="10"/>
                        <ComboBox x:Name="GameProfileCombo" Height="34" Margin="0,6,0,0"
                                  DisplayMemberPath="Name" SelectionChanged="GameProfileCombo_SelectionChanged"
                                  Background="#14283A" Foreground="#EAF7FF"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="游戏名称" Foreground="#8CA4BD" FontSize="10"/>
                        <TextBox x:Name="ProfileNameInput" Height="34" Margin="0,6,0,0"
                                 Background="#14283A" Foreground="#EAF7FF" BorderBrush="#31516B"
                                 Padding="8,5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="EXE 进程名" Foreground="#8CA4BD" FontSize="10"/>
                        <TextBox x:Name="ProcessNameInput" Width="140" Height="34" Margin="0,6,0,0"
                                 Background="#14283A" Foreground="#EAF7FF" BorderBrush="#31516B"
                                 Padding="8,5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="运行状态" Foreground="#8CA4BD" FontSize="10"/>
                        <TextBlock x:Name="GameProcessStatus" Text="尚未选择游戏" FontSize="14"
                                   Foreground="#F3C969" Margin="0,12,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="添加档案" Click="AddGameProfileButton_Click"
                                Background="#12364A" Foreground="#27D7F2" BorderBrush="#1C6686"
                                Padding="12,8" Margin="0,0,6,0"/>
                        <Button Content="删除" Click="DeleteGameProfileButton_Click"
                                Background="#30202A" Foreground="#FF9B9B" BorderBrush="#68404A"
                                Padding="12,8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Panel}" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="GLOBAL ROUTE TOPOLOGY" FontSize="11" Foreground="#8CA4BD"/>
                            <TextBlock DockPanel.Dock="Right" Text="LIVE TELEMETRY" FontSize="10" Foreground="#27D7F2"/>
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,12">
                            <Ellipse Width="300" Height="300" Stroke="#1C6686" StrokeThickness="1" Opacity="0.7"/>
                            <Ellipse Width="230" Height="230" Stroke="#17607C" StrokeThickness="1" Opacity="0.55"/>
                            <Ellipse Width="160" Height="160" Stroke="#27D7F2" StrokeThickness="1" Opacity="0.35"/>
                            <Ellipse Width="12" Height="12" Fill="#27D7F2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Path Stroke="#27D7F2" StrokeThickness="2" Opacity="0.8" Data="M 170,180 C 260,70 350,280 470,145"/>
                            <Path Stroke="#6C7CFF" StrokeThickness="1.5" Opacity="0.8" Data="M 170,180 Q 320,330 500,190"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,190,0,0">
                                <TextBlock Text="NETWORK CORE" FontSize="10" Foreground="#8CA4BD" HorizontalAlignment="Center"/>
                                <TextBlock Text="等待节点接入" FontSize="18" Foreground="#27D7F2" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="拓扑示意图为界面占位；接入真实节点后才显示节点状态与线路。" Foreground="#8CA4BD" FontSize="10" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="ACCELERATION STATUS" Foreground="#8CA4BD" FontSize="10"/>
                            <TextBlock Text="尚未连接加速节点" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <TextBlock Text="当前仅采集本机网络指标，不会自动改变系统路由。" Foreground="#8CA4BD" TextWrapping="Wrap" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="NETWORK QUALITY" Foreground="#8CA4BD" FontSize="10"/>
                            <TextBlock x:Name="PingText" Text="延迟    -- ms" FontSize="17" Margin="0,8,0,2"/>
                            <TextBlock x:Name="JitterText" Text="抖动    -- ms" FontSize="17" Margin="0,2"/>
                            <TextBlock x:Name="LossText" Text="丢包    -- %" FontSize="17" Margin="0,2"/>
                            <TextBlock x:Name="PingDetailText" Text="等待测试" FontSize="10" Foreground="#8CA4BD" Margin="0,6,0,0"/>
                            <Button x:Name="RunDiagnosticsButton" Content="开始网络质量检测" Click="RunDiagnosticsButton_Click"
                                    Background="#12364A" Foreground="#27D7F2" BorderBrush="#1C6686"
                                    Padding="10,8" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="SECURITY" Foreground="#8CA4BD" FontSize="10"/>
                            <TextBlock Text="基础安全状态：待检测" Foreground="#F3C969" FontSize="14" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <UniformGrid Grid.Row="3" Columns="4" Margin="0,4,0,0">
                <Border Style="{StaticResource Panel}">
                    <StackPanel><TextBlock Text="DOWNLOAD" Foreground="#8CA4BD" FontSize="10"/><TextBlock x:Name="DownloadText" Text="读取中…" FontSize="25" Foreground="#27D7F2" Margin="0,8,0,0"/><TextBlock Text="实时接收速率" Foreground="#8CA4BD" FontSize="10"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}">
                    <StackPanel><TextBlock Text="UPLOAD" Foreground="#8CA4BD" FontSize="10"/><TextBlock x:Name="UploadText" Text="读取中…" FontSize="25" Foreground="#6C9BFF" Margin="0,8,0,0"/><TextBlock Text="实时发送速率" Foreground="#8CA4BD" FontSize="10"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}">
                    <StackPanel><TextBlock Text="ACTIVE ADAPTER" Foreground="#8CA4BD" FontSize="10"/><TextBlock x:Name="AdapterText" Text="检测中…" FontSize="16" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="活动网络接口" Foreground="#8CA4BD" FontSize="10"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}">
                    <StackPanel><TextBlock Text="MONITORING" Foreground="#8CA4BD" FontSize="10"/><TextBlock Text="LOCAL ONLY" FontSize="18" Foreground="#65E6C2" Margin="0,8,0,0"/><TextBlock Text="无流量接管 / 无后台上传" Foreground="#8CA4BD" FontSize="10"/></StackPanel>
                </Border>
            </UniformGrid>
        </Grid>
    </Grid>
</Window>
