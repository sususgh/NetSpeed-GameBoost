<Application x:Class="NetSpeed.GameBoost.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#070B16"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#101A2B"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#27D7F2"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8CA4BD"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAF7FF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Application.Resources>
</Application>
